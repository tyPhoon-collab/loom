{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uvx code-review-graph update --repo /Users/hiroaki/projects/loom --skip-flows >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Updating code-review-graph"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uvx code-review-graph status --repo /Users/hiroaki/projects/loom >/dev/null 2>&1 || true",
            "timeout": 10,
            "statusMessage": "Checking code-review-graph status"
          }
        ]
      }
    ]
  }
}
